# ─────────────────────────────────────────────────────────────
# NameIt configuration. Copy to .env.local and fill in.
# With nothing set, NameIt runs in DEMO mode (no AI, dataset only).
# All of these are server-side only — never prefix them with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Which provider implementation to use: "openai-compatible" or "demo".
# Defaults to openai-compatible when AI_BASE_URL is set, otherwise demo.
AI_PROVIDER=

# ── Recommended free setup: OpenRouter free vision models ────
# Get a key at https://openrouter.ai/keys and uncomment:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemma-4-31b-it:free
# AI_FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,qwen/qwen3.8-27b:free
# AI_API_KEY=sk-or-...
# AI_EXTRA_BODY={"reasoning":{"enabled":false}}
# AI_PROVIDER_LABEL=OpenRouter
# AI_PROVIDER_MAY_TRAIN=true
# ──────────────────────────────────────────────────────────────

# Any OpenAI-style Chat Completions endpoint that accepts image input.
# Other examples (see README for more):
#   Ollama (local, free, open source):   http://localhost:11434/v1        AI_MODEL=qwen2.5vl:7b
#   Hugging Face Inference Providers:    https://router.huggingface.co/v1 AI_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#   OpenRouter:                          https://openrouter.ai/api/v1     AI_MODEL=<a vision model id>
#   Groq:                                https://api.groq.com/openai/v1   AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_BASE_URL=
AI_MODEL=
# Not needed for local Ollama.
AI_API_KEY=

# OpenRouter only: up to 2 models to try in order if AI_MODEL is rate-limited or down.
AI_FALLBACK_MODELS=
# Extra JSON fields merged into every request (provider-specific options).
AI_EXTRA_BODY=

# Send response_format=json_object (auto-disabled if the server rejects it).
AI_JSON_MODE=true
AI_TIMEOUT_MS=60000

# Shown in the privacy notice under the upload area, e.g. "Hugging Face".
# Defaults to the AI_BASE_URL hostname.
AI_PROVIDER_LABEL=
# Set to true if AI_BASE_URL points at a model you host yourself (not localhost).
AI_PROVIDER_IS_SELF_HOSTED=false
# Set to true if the provider may keep/train on submitted images (e.g. free
# OpenRouter models). Adds a sentence saying so to the privacy notice.
AI_PROVIDER_MAY_TRAIN=false

# Optional external name source: the free Datamuse word API. Only derived
# keywords (never images or user text) are sent. Off by default.
NAME_SOURCE_DATAMUSE=false

# Requests allowed per client per window.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# Extra origins allowed to call the API (comma separated). Same-origin always works.
ALLOWED_ORIGINS=
